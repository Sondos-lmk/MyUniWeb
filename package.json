{
  "name": "mern-campus-starter",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm --workspaces install",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev --workspace server\" \"npm:dev --workspace client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "nodemailer": "^7.0.9",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.2",
    "xlsx": "^0.18.5"
  }
}
